<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Exterior Production's | Landscaping Services</title>
  <style>
    /* Reset and base styles */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, sans-serif; line-height: 1.6; color: #333; }
    a { text-decoration: none; color: inherit; }
    h1, h2, h3 { margin-bottom: 15px; }

    /* Layout */
    header {
      background: url('https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=1600&q=80') no-repeat center center/cover;
      height: 100vh;
      display: flex; flex-direction: column;
      justify-content: center; align-items: center;
      color: white; text-align: center;
      padding: 0 20px;
    }
    header h1 { font-size: 3rem; }
    header p { font-size: 1.2rem; margin: 15px 0; }
    .btn {
      display: inline-block;
      padding: 12px 25px;
      margin-top: 15px;
      background: #2e7d32;
      color: white; font-weight: bold;
      border-radius: 8px;
      transition: background 0.3s;
    }
    .btn:hover { background: #1b5e20; }

    section { padding: 60px 20px; text-align: center; }
    .services, .jobs, .contact { background: #f9f9f9; }
    .section-title { font-size: 2rem; margin-bottom: 30px; color: #2e7d32; }

    /* Services grid */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      max-width: 1100px;
      margin: 0 auto;
    }
    .service {
      background: white; padding: 20px; border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .service img { width: 100%; border-radius: 12px; margin-bottom: 15px; }

    /* Contact */
    .contact p { margin: 10px 0; font-size: 1.1rem; }
    footer {
      background: #2e7d32; color: white; text-align: center;
      padding: 20px; margin-top: 30px;
    }
  </style>
</head>
<body>
  <!-- Hero Section -->
  <header id="home">
    <h1>Exterior Production's</h1>
    <p>Professional Landscaping & Outdoor Solutions</p>
    <a href="tel:+17206630646" class="btn">📞 Call Now: (720) 663-0646</a>
  </header>

  <!-- Services Section -->
  <section class="services" id="services">
    <h2 class="section-title">Our Services</h2>
    <div class="services-grid">
      <div class="service">
        <img src="https://images.unsplash.com/photo-1597004891283-d1073ec6d722?auto=format&fit=crop&w=800&q=80" alt="Lawn Care">
        <h3>Lawn Care</h3>
        <p>Expert mowing, edging, and lawn maintenance to keep your yard pristine.</p>
      </div>
      <div class="service">
        <img src="https://images.unsplash.com/photo-1599058917212-d750089bc04e?auto=format&fit=crop&w=800&q=80" alt="Hardscaping">
        <h3>Hardscaping</h3>
        <p>Patios, walkways, and stone features to transform your outdoor space.</p>
      </div>
      <div class="service">
        <img src="https://images.unsplash.com/photo-1523413651479-597eb2da0ad6?auto=format&fit=crop&w=800&q=80" alt="Garden Design">
        <h3>Garden Design</h3>
        <p>Custom plantings, flower beds, and landscaping designs to bring your vision to life.</p>
      </div>
    </div>
  </section>

  <!-- Free Quote Section -->
  <section class="quote" id="quote">
    <h2 class="section-title">Request a Free Quote</h2>
    <p>We provide free estimates for all landscaping services. Call today to schedule your appointment.</p>
    <a href="tel:+17206630646" class="btn">📞 Get Your Free Quote</a>
  </section>

  <!-- Jobs Section -->
  <section class="jobs" id="jobs">
    <h2 class="section-title">Employment Opportunities</h2>
    <p>We’re always looking for motivated individuals to join our team. Apply now and grow with us!</p>
    <a href="mailto:clvnwls@gmail.com" class="btn">📧 Apply Now</a>
  </section>

  <!-- Contact Section -->
  <section class="contact" id="contact">
    <h2 class="section-title">Contact Us</h2>
    <p><strong>Phone:</strong> <a href="tel:+17206630646">(720) 663-0646</a></p>
    <p><strong>Email (Jobs):</strong> <a href="mailto:clvnwls@gmail.com">clvnwls@gmail.com</a></p>
  </section>

  <footer>
    <p>© 2025 Exterior Production's. All rights reserved.</p>
  </footer>
</body>
</html>
